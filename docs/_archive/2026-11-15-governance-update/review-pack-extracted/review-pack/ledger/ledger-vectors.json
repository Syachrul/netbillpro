  {
    "id": "T13-idempotensi",
    "steps": [
      {
        "op": "issueInvoice",
        "as": "INV1",
        "total": 150000,
        "dueDate": "2027-01-10"
      },
      {
        "op": "postPayment",
        "as": "P1",
        "amount": 150000,
        "idempotencyKey": "K1"
      },
      {
        "op": "postPayment",
        "amount": 150000,
        "idempotencyKey": "K1",
        "expectSameResponseAs": "P1"
      },
      {
        "op": "postPayment",
        "amount": 999000,
        "idempotencyKey": "K1",
        "expectError": "IDEMPOTENCY_CONFLICT"
      }
    ],
    "expect": {
      "paymentCount": 1,
      "balance": 0,
      "ledgerEntryCount": 2
    }
  },
  {
    "id": "T15-impor-saldo-awal",
    "customers": {
      "A": {
        "openingBalance": -300000,
        "dueDate": "2026-11-30"
      },
      "B": {
        "openingBalance": 80000
      }
    },
    "steps": [
      {
        "op": "issueInvoice",
        "customer": "A",
        "as": "A-INV1",
        "total": 150000,
        "dueDate": "2026-12-10"
      },
      {
        "op": "issueInvoice",
        "customer": "B",
        "as": "B-INV1",
        "total": 150000,
        "dueDate": "2026-12-10"
      }
    ],
    "expect": {
      "A": {
        "balance": -450000,
        "totalDue": 450000,
        "freeCredit": 0
      },
      "B": {
        "balance": -70000,
        "totalDue": 70000,
        "freeCredit": 0,
        "invoices": {
          "B-INV1": {
            "allocated": 80000,
            "status": "DIBAYAR_SEBAGIAN"
          }
        }
      }
    }
  },
