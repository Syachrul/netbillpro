// check-decisions-log.mjs — v2 (2026-11-15, per OWNER REVIEW DECISION-LOG-RECON-01)
// Distinguishes Decision ID vs Document ID. Recognizes VOID/DUPLICATE/ABBREV-DUP/SUPERSEDED markers.
// Verifies DLR-02 (C3 VOID) and DLR-06 (C5.0 schema claim VOID) corrections exist.
// Usage: node check-decisions-log.mjs <decisions.log>  (exit 1 if any finding)

import { readFileSync } from 'node:fs';
const path = process.argv[2];
if (!path) { console.error('pemakaian: node check-decisions-log.mjs <decisions.log>'); process.exit(2); }
const lines = readFileSync(path, 'utf8').replace(/\r/g, '').split('\n');

// ===== Parsing =====
const entries = [];
let cur = null;
const flush = () => { if (cur) { cur.text = cur.buf.join('\n').trim(); entries.push(cur); cur = null; } };
lines.forEach((l, i) => {
  let m;
  if ((m = l.match(/^(\d{4}-\d{2}-\d{2}) \| ([^|]+?) \|/))) {
    flush(); entries.push({ kind: 'row', date: m[1], id: m[2].trim(), text: l, line: i + 1 });
  } else if ((m = l.match(/^\[(\d{4}-\d{2}-\d{2})\]\s+(.*)$/))) {
    flush(); cur = { kind: 'block', date: m[1], title: m[2].trim(), id: null, buf: [l], line: i + 1 };
  } else if (cur && !l.startsWith('# ')) {
    cur.buf.push(l);
  } else if (cur && l.startsWith('# ')) {
    flush();
  }
});
flush();

// ===== Helpers =====
const norm = (t) => t.toLowerCase().replace(/\s+/g, ' ').replace(/^\[\d{4}-\d{2}-\d{2}\]/, '').trim();
const toks = (t) => new Set(norm(t).split(/[^a-z0-9_\-<>=.]+/).filter(Boolean));
const jac = (a, b) => { const i = [...a].filter(x => b.has(x)).length; return i / (a.size + b.size - i); };

const DECISION_ID_RE = /\b(D-\d+|D-NB-\d+(?:-[A-Z]+)?|OQ-\d+|OQ-[A-Z]\b|T\d+)\b/;
const DOCUMENT_ID_RE = /\b(DEV-RTRW|PRD-RTRW|TDD-RTRW|ADR-\d{4}|SPEC-[A-Z]+-\d+|GOV-[A-Z]+-\d+|ART-[A-Z]+-\d+|TRACE-[A-Z]+-\d+|REVIEW-\d+)\b/i;

const hasVoid        = (e) => /<!--\s*VOID/i.test(e.text) || /VOID\s*—\s*UNAUTHORIZED/.test(e.text);
const hasDuplicate   = (e) => /<!--\s*DUPLICATE/i.test(e.text);
const hasAbbrevDup   = (e) => /<!--\s*ABBREVIATED DUPLICATE/i.test(e.text);
const hasSuperseded  = (e) => /\[SUPERSEDED /.test(e.text) || /<!--\s*SUPERSEDED/i.test(e.text);
const isCorrection   = (e) => /\[CORRECTION \d{4}-\d{2}-\d{2}\]/.test(e.text);
const isSkipped      = (e) => hasVoid(e) || isCorrection(e) || hasDuplicate(e) || hasAbbrevDup(e);

// Parse addendum canonical mappings: "# - <keyword> = <ID> [<tag>]"
const mappings = [];
for (const l of lines) {
  const m = l.match(/^# - (.+?) = (D-NB-\d+(?:-[A-Z]+)?)\s*\[(.+?)\]/);
  if (m) mappings.push({ keyword: m[1].trim(), id: m[2], tag: m[3] });
}
const canonicalMappings = mappings.filter(m => /canonical/i.test(m.tag));

const findings = [];
const blocks = entries.filter(e => e.kind === 'block');

// 1) TANPA-ID — block valid if: Decision ID in title, OR Document ID in content, OR canonical mapping matches title
for (const e of entries) {
  if (e.kind !== 'block') continue;
  if (isSkipped(e)) continue;
  const fullText = e.title + '\n' + e.text;
  const hasDecId = DECISION_ID_RE.test(e.title);
  const hasDocId = DOCUMENT_ID_RE.test(fullText);
  const hasMapped = canonicalMappings.some(m => e.title.includes(m.keyword));
  if (!hasDecId && !hasDocId && !hasMapped) {
    findings.push(`TANPA-ID   baris ${e.line}: "${e.title}"`);
  }
}

// 2) DUPLIKAT / MIRIP-BEDA — skip marked blocks
for (let i = 0; i < blocks.length; i++) for (let j = i + 1; j < blocks.length; j++) {
  const a = blocks[i], b = blocks[j];
  if (isSkipped(a) || isSkipped(b)) continue;
  if (norm(a.text) === norm(b.text)) {
    findings.push(`DUPLIKAT   baris ${b.line} identik dengan baris ${a.line} ("${a.title}")`);
  } else {
    const s = jac(toks(a.text), toks(b.text));
    if (s >= 0.8) findings.push(`MIRIP-BEDA baris ${b.line} ~ baris ${a.line} (${(s*100).toFixed(0)}%)`);
  }
}

// 3) ID-GANDA — count only non-void, non-dup, non-superseded entries
const defs = new Map();
for (const e of entries) {
  if (isSkipped(e) || hasSuperseded(e)) continue;
  let ids = [];
  if (e.kind === 'row') {
    ids = [e.id];
  } else {
    const matches = (e.text.match(/\b(D-NB-\d+|OQ-\d+|OQ-[A-Z]\b|T\d+)\b/g) || []);
    ids = [...new Set(matches)];
  }
  for (const id of ids) {
    if (!defs.has(id)) defs.set(id, []);
    defs.get(id).push(e);
  }
}
for (const [id, es] of defs) {
  if (es.length > 1) {
    findings.push(`ID-GANDA   ${id} muncul ${es.length}× (baris ${es.map(e => e.line).join(', ')})`);
  }
}

// 4) URUTAN
for (let i = 1; i < entries.length; i++) {
  if (entries[i].date < entries[i - 1].date) {
    findings.push(`URUTAN     baris ${entries[i].line} (${entries[i].date}) lebih lama dari sebelumnya (${entries[i - 1].date})`);
  }
}

// 5) FORMAT — addendum v2 must exist
const hasAddendum = lines.some(l => /ADDENDUM FORMAT v2/.test(l));
if (!hasAddendum) findings.push('FORMAT     ADDENDUM FORMAT v2 tidak ditemukan');

// 6) VOID coverage — corrections must exist for DLR-02 and DLR-06
const hasDlr02Correction = lines.some(l => /\[CORRECTION \d{4}-\d{2}-\d{2}\] VOID — UNAUTHORIZED ENTRY/i.test(l));
const hasDlr06Correction = lines.some(l => /\[CORRECTION \d{4}-\d{2}-\d{2}\] VOID — UNAUTHORIZED CLAIM/i.test(l));
const hasC3VoidedBlock   = blocks.some(b => /C3 AUTHORIZATION/i.test(b.title) && hasVoid(b));
const hasC5SchemaClaim   = blocks.some(b => /Schema implementation AUTHORIZED/i.test(b.text) && !isSkipped(b));

if (hasC3VoidedBlock && !hasDlr02Correction) findings.push('DLR-02     C3 block VOIDED but no [CORRECTION] record found');
if (hasC5SchemaClaim && !hasDlr06Correction) findings.push('DLR-06     C5.0 schema claim present but no [CORRECTION] record found');

// ===== Output =====
console.log(`entri: ${entries.length} (baris tabel ${entries.filter(e => e.kind === 'row').length}, blok ${blocks.length})`);
console.log(`markers: VOID=${blocks.filter(hasVoid).length}, DUP=${blocks.filter(hasDuplicate).length}, ABBREV-DUP=${blocks.filter(hasAbbrevDup).length}, SUPERSEDED=${entries.filter(hasSuperseded).length}`);
console.log(`corrections: DLR-02=${hasDlr02Correction}, DLR-06=${hasDlr06Correction}`);
console.log(`mappings: ${mappings.length} entries, ${canonicalMappings.length} canonical`);
findings.forEach(f => console.log(' - ' + f));
console.log(findings.length ? `\n${findings.length} temuan` : '\nbersih');
process.exit(findings.length ? 1 : 0);
