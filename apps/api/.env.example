# API server (NestJS + Fastify)
NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta

# Database (sesuai infra/docker/.env)
DATABASE_URL=postgresql://netbill:netbill_dev@localhost:5432/netbill

# Redis (dipakai di S1 untuk BullMQ)
REDIS_URL=redis://localhost:6379

# JWT (placeholder - isi nilai kuat di S1)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Enkripsi secret (AES-256, base64 dari 32 byte acak)
SECRETS_ENCRYPTION_KEY=change-me-to-base64-of-32-bytes

# CORS (origin web dev)
CORS_ORIGINS=http://localhost:5173
